[
	// Navigate between terminals just like browser tabs
	{
		"key": "shift+cmd+]",
		"command": "workbench.action.terminal.focusNext",
		"when": "(terminalFocus || terminalTabsFocus) && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
	},
	{
		"key": "shift+cmd+[",
		"command": "workbench.action.terminal.focusPrevious",
		"when": "(terminalFocus || terminalTabsFocus) && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus"
	},
	// Close the current terminal window with cmd+w
	{
		"key": "cmd+w",
		"command": "workbench.action.terminal.kill",
		"when": "terminalFocus || terminalTabsFocus"
	},
	// Use the duplicate action extension for duplicating files in the explorer
	{
		"key": "cmd+d",
		"command": "runCommands",
		"args": {
			"commands": [
				"filesExplorer.copy",
				"filesExplorer.paste"
			]
		},
		"when": "filesExplorerFocus && !inputFocus"
	},
	// Override default terminal split to use cmd+shift+s tinstead of ctrl+shift+5
	{
		"key": "cmd+d",
		"command": "workbench.action.terminal.split",
		"when": "terminalFocus && terminalProcessSupported || terminalFocus && terminalWebExtensionContributedProfile"
	},
	// Disable conflicting Jupyter/Python keybindings for Shift+Enter where lines would be sent to the terminal
	{
		"key": "shift+enter",
		"command": "type",
		"args": {
			"text": "\n"
		},
		"when": "editorTextFocus"
	},
	// Use terminal movement just like web browser tabs
	{
		"key": "cmd+1",
		"command": "workbench.action.terminal.focusAtIndex1",
		"when": "terminalFocus || terminalTabsFocus"
	},
	{
		"key": "cmd+2",
		"command": "workbench.action.terminal.focusAtIndex2",
		"when": "terminalFocus"
	},
	{
		"key": "cmd+3",
		"command": "workbench.action.terminal.focusAtIndex3",
		"when": "terminalFocus || terminalTabsFocus"
	},
	{
		"key": "cmd+4",
		"command": "workbench.action.terminal.focusAtIndex4",
		"when": "terminalFocus || terminalTabsFocus"
	},
	{
		"key": "cmd+5",
		"command": "workbench.action.terminal.focusAtIndex5",
		"when": "terminalFocus || terminalTabsFocus"
	},
	{
		"key": "cmd+6",
		"command": "workbench.action.terminal.focusAtIndex6",
		"when": "terminalFocus || terminalTabsFocus"
	},
	{
		"key": "cmd+7",
		"command": "workbench.action.terminal.focusAtIndex7",
		"when": "terminalFocus || terminalTabsFocus"
	},
	{
		"key": "cmd+8",
		"command": "workbench.action.terminal.focusAtIndex8",
		"when": "terminalFocus || terminalTabsFocus"
	},
	{
		"key": "cmd+9",
		"command": "workbench.action.terminal.focusAtIndex9",
		"when": "terminalFocus || terminalTabsFocus"
	},
	// Use tab movement just like web browser tabs
	{
		"key": "cmd+0",
		"command": "workbench.action.openLastEditorInGroup",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+1",
		"command": "workbench.action.openEditorAtIndex1",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+2",
		"command": "workbench.action.openEditorAtIndex2",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+3",
		"command": "workbench.action.openEditorAtIndex3",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+4",
		"command": "workbench.action.openEditorAtIndex4",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+5",
		"command": "workbench.action.openEditorAtIndex5",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+6",
		"command": "workbench.action.openEditorAtIndex6",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+7",
		"command": "workbench.action.openEditorAtIndex7",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+8",
		"command": "workbench.action.openEditorAtIndex8",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	{
		"key": "cmd+9",
		"command": "workbench.action.openEditorAtIndex9",
		"when": "!terminalFocus && !terminalTabsFocus"
	},
	// Use Notion's sidebar toggle (my fav)
	{
		"key": "cmd+\\",
		"command": "workbench.action.toggleSidebarVisibility"
	},
	{
		"key": "cmd+r",
		"command": "workbench.action.reloadWindow",
	},
	// Power Clipper copy file contents for ai
	{
		"key": "cmd+shift+c",
		"command": "power-clipper.copyFilesContentOnly",
		"when": "filesExplorerFocus"
	},
	// Power clipper just copy file tree for ai
	{
		"key": "cmd+shift+t",
		"command": "power-clipper.copyFolderStructure",
		"when": "filesExplorerFocus"
	},
	// Change rename symbol to cmd + shift + enter
	{
		"key": "cmd+shift+enter",
		"command": "editor.action.rename",
		"when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
	},
	// Allow me to redo with cmd+shift+z
	{
		"key": "cmd+shift+z",
		"command": "redo",
		// "when": "textInputFocus"
	},
	// Allow me to open source control with cmd+shift+g
	{
		"key": "cmd+shift+g",
		"command": "workbench.view.scm",
		// "when": "workbench.scm.active"
	},
	// Reveal the selected file in Finder
	{
		"key": "alt+cmd+r",
		"command": "revealFileInOS",
		"when": "!editorFocus"
	},
	// inactive -- replaced by raycast search filesystem
	// Allow me to format the document with cmd+shift+f
	// {
	// 	"key": "cmd+shift+f",
	// 	"command": "editor.action.formatDocument",
	// 	// "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
	// },
	// Open a new terminal with cmd+n when terminal is focused
	{
		"key": "cmd+n",
		"command": "workbench.action.terminal.new",
		"when": "terminalFocus || terminalTabsFocus"
	},
	// Below are the same as default, they are just shortcuts I am familiar with and use often
	{
		"key": "cmd+k",
		"command": "workbench.action.terminal.clear",
		"when": "terminalFocus && terminalHasBeenCreated && !accessibilityModeEnabled || terminalFocus && terminalProcessSupported && !accessibilityModeEnabled || accessibilityModeEnabled && accessibleViewIsShown && terminalHasBeenCreated && accessibleViewCurrentProviderId == 'terminal' || accessibilityModeEnabled && accessibleViewIsShown && terminalProcessSupported && accessibleViewCurrentProviderId == 'terminal'"
	},
	// Allow me to open the command palette with cmd+shift+p
	{
		"key": "cmd+shift+p",
		"command": "workbench.action.showCommands",
		"when": "textInputFocus"
	},
	// inactive -- used for search emojis and symbols globally
	// {
	// 	"key": "shift+cmd+e",
	// 	"command": "workbench.view.explorer",
	// 	"when": "viewContainer.workbench.view.explorer.enabled"
	// },
	{
		"key": "shift+cmd+x",
		"command": "workbench.view.extensions",
		"when": "viewContainer.workbench.view.extensions.enabled"
	},
	{
		"key": "shift+enter",
		"command": "workbench.action.terminal.sendSequence",
		"args": {
			"text": "\u001b\r"
		},
		"when": "terminalFocus"
	},
]