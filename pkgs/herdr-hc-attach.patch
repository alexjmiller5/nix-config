+'use strict';
+const {execFileSync}=require('node:child_process');
+function rpc(method,params){
+ const text=execFileSync(process.env.HC_BIN_PATH||'hc',['connect'],{input:JSON.stringify({jsonrpc:'2.0',id:1,method,params})+'\n',encoding:'utf8',timeout:10000});
+ const reply=JSON.parse(text);
+ if(reply.error){const e=new Error(reply.error.message);e.kind=reply.error.data?.kind;throw e;}
+ return reply.result;
+}
+function walk(root){
+ if(!root||typeof root!=='object')return [];
+ return [...(typeof root.content?.terminal==='string'?[root.content.terminal]:[]),...(root.children||[]).flatMap(walk)];
+}
+function toAppList(doc,terminals){
+ if(!doc||!Array.isArray(doc.spaces))throw new Error('Core app document unavailable');
+ const live=new Map(terminals.filter(t=>t.state==='live').map(t=>[t.address,t]));
+ return {spaces:doc.spaces.filter(s=>!s.machine).map(s=>({...s,name:s.name||'Core',tabs:(s.tabs||[]).map(t=>({...t,name:t.name||'Core '+(walk(t.root)[0]||t.id),terminals:walk(t.root).filter(a=>live.has(a)).map(a=>({terminal:a,app:live.get(a).status?.app||live.get(a).agent||'',status:live.get(a).status?.state||'unknown'}))}))}))};
+}
+function adopt(doc,terminal){
+ const spaceId=terminal.labels?.['herdr.space'],tabId=terminal.labels?.['herdr.tab'];
+ if(!/^[A-Za-z0-9_-]{1,128}$/.test(spaceId||'')||!/^[A-Za-z0-9_-]{1,128}$/.test(tabId||'')||!/^t[0-9a-z]+$/.test(terminal.address||''))throw new Error('Missing or invalid explicit Core layout labels');
+ const out=structuredClone(doc||{spaces:[]});
+ if(!Array.isArray(out.spaces))throw new Error('Invalid Core layout');
+ if(out.spaces.some(s=>(s.tabs||[]).some(t=>walk(t.root).includes(terminal.address))))return out;
+ let space=out.spaces.find(s=>s.id===spaceId);
+ if(!space){space={id:spaceId,name:'',folder:terminal.cwd||'',tabs:[]};out.spaces.push(space);}
+ if(space.machine)throw new Error('Refusing to adopt into a remote space');
+ let tab=space.tabs.find(t=>t.id===tabId);
+ if(!tab){tab={id:tabId,name:'',root:{id:tabId,type:'row',children:[]}};space.tabs.push(tab);}
+ const block={id:'p'+require('node:crypto').randomUUID().replaceAll('-',''),type:'block',content:{terminal:terminal.address}};
+ if(tab.root?.type==='row')tab.root.children.push(block);
+ else tab.root={id:'r'+require('node:crypto').randomUUID().replaceAll('-',''),type:'row',children:[...(tab.root?[tab.root]:[]),block]};
+ return out;
+}
+function rename(doc,command,id,name){
+ const out=structuredClone(doc);
+ const target=command==='space.rename'?out.spaces.find(s=>s.id===id):command==='tab.rename'?out.spaces.flatMap(s=>s.tabs||[]).find(t=>t.id===id):null;
+ if(!target)throw new Error('Layout identity unavailable');
+ target.name=name;return out;
+}
+function mutate(fn){
+ for(let attempt=0;attempt<3;attempt++){
+  const current=rpc('doc.get',{name:'herdr-app'});
+  const value=fn(current.value);
+  if(JSON.stringify(value)===JSON.stringify(current.value))return;
+  try{rpc('doc.set',{name:'herdr-app',version:current.version,value});return;}
+  catch(e){if(e.kind!=='conflict'||attempt===2)throw e;}
+ }
+}
+function list(){return toAppList(rpc('doc.get',{name:'herdr-app'}).value,rpc('terminal.list',{}).terminals);}
+function adoptTerminal(address){const terminal=rpc('terminal.get',{terminal:address});mutate(doc=>adopt(doc,terminal));}
+function namePolicy(ops,spaces){
+ return ops.map(op=>{
+  if(op.type==='renameAppTab'){
+   const tab=spaces.flatMap(s=>s.tabs).find(t=>t.tabId===op.tabId);
+   if(!tab)throw new Error('Core tab unavailable during naming');
+   return {...op,type:'renameTab',name:tab.name};
+  }
+  if(op.type==='renameAppSpace'){
+   const space=spaces.find(s=>s.spaceId===op.spaceId);
+   if(!space)throw new Error('Core space unavailable during naming');
+   return {...op,type:'renameWorkspace',name:space.name};
+  }
+  return op;
+ });
+}
+module.exports={toAppList,adopt,rename,list,mutate,adoptTerminal,namePolicy};
--- a/tests/core-layout.test.js
+++ b/tests/core-layout.test.js
@@ -0,0 +1,51 @@
+const {test}=require('node:test');
+const assert=require('node:assert/strict');
+const {toAppList,adopt,rename,namePolicy}=require('../lib/core-layout');
+const doc={custom:{keep:true},spaces:[{id:'sp1',name:'Work',folder:'/fixture',tabs:[{id:'tb1',name:'One',root:{type:'row',children:[{type:'block',content:{terminal:'t1'}}]},custom:42}]}]};
+test('maps live local terminals without touching the document',()=>{
+ const before=JSON.stringify(doc);
+ const out=toAppList(doc,[{address:'t1',state:'live',agent:'codex'}]);
+ assert.equal(out.spaces[0].tabs[0].terminals[0].terminal,'t1');
+ assert.equal(out.spaces[0].tabs[0].terminals[0].app,'codex');
+ assert.equal(JSON.stringify(doc),before);
+ assert.equal(toAppList(doc,[]).spaces[0].tabs[0].terminals.length,0);
+});
+test('adopts only the explicitly created labelled terminal, idempotently',()=>{
+ const terminal={address:'t2',cwd:'/fixture',labels:{'herdr.space':'sp1','herdr.tab':'tb2'}};
+ const result=adopt(doc,terminal);
+ assert.equal(doc.spaces[0].tabs.length,1);
+ assert.equal(result.spaces[0].tabs.length,2);
+ assert.deepEqual(adopt(result,terminal),result);
+ assert.deepEqual(result.custom,{keep:true});
+ assert.throws(()=>adopt(doc,{...terminal,labels:{}}));
+});
+test('rename preserves every unrelated field and rejects missing identity',()=>{
+ const result=rename(doc,'tab.rename','tb1','Changed');
+ assert.equal(result.spaces[0].tabs[0].name,'Changed');
+ assert.equal(result.spaces[0].tabs[0].custom,42);
+ assert.deepEqual(result.spaces[0].tabs[0].root,doc.spaces[0].tabs[0].root);
+ assert.throws(()=>rename(doc,'tab.rename','missing','Changed'));
+});
+
+test('Core naming policy never writes a TUI automatic title into Core',()=>{
+ const input=[{type:'renameAppTab',tabId:'tb1',tuiTabId:'w1:t1',name:'10 · herdr-core'},{type:'renameAppSpace',spaceId:'sp1',workspaceId:'w1',name:'Noise'}];
+ const result=namePolicy(input,[{spaceId:'sp1',name:'Work',tabs:[{tabId:'tb1',name:'One'}]}]);
+ assert.deepEqual(result,[{type:'renameTab',tabId:'tb1',tuiTabId:'w1:t1',name:'One'},{type:'renameWorkspace',spaceId:'sp1',workspaceId:'w1',name:'Work'}]);
+});
+
+test('failed layout adoption is not reported as a successfully shared terminal',()=>{
+ const fs=require('node:fs'),os=require('node:os'),path=require('node:path');
+ const temp=fs.mkdtempSync(path.join(os.tmpdir(),'bridge-check-'));
+ const executable=path.join(temp,'hc');
+ fs.writeFileSync(executable,"#!/bin/sh\nprintf '%s\\n' '{\"address\":\"t2\"}'\n",{mode:0o755});
+ const layout=require('../lib/core-layout'),previous=layout.adoptTerminal;
+ const env={bin:process.env.HC_BIN_PATH,mode:process.env.HC_BRIDGE_CORE_LAYOUT};
+ process.env.HC_BIN_PATH=executable;process.env.HC_BRIDGE_CORE_LAYOUT='1';
+ layout.adoptTerminal=()=>{throw new Error('guard failed');};
+ try{assert.throws(()=>require('../lib/sync-run').startTerminal(['run']),/guard failed/);}
+ finally{
+  layout.adoptTerminal=previous;
+  for(const [key,value] of [['HC_BIN_PATH',env.bin],['HC_BRIDGE_CORE_LAYOUT',env.mode]]){if(value===undefined)delete process.env[key];else process.env[key]=value;}
+  fs.rmSync(temp,{recursive:true});
+ }
+});
