@@ -0,0 +1,51 @@
+"""Closing must record the current session before the terminal disappears."""
+import os
+import tempfile
+import unittest
+from unittest.mock import patch
+from herdr_undo_close import cli, store
+from test_record import FakeApi
+
+class TestClose(unittest.TestCase):
+    @patch.dict(os.environ, {"HERDR_TAB_ID": "w1:t2"}, clear=True)
+    def test_record_then_close(self):
+        calls = []
+        with patch.object(cli, "cmd_record", side_effect=lambda args, **kwargs: calls.append("record") or 0), patch.object(cli, "HerdrApi") as api:
+            api.return_value.__enter__.return_value.call.side_effect = lambda method, params: calls.append((method, params))
+            self.assertEqual(cli.COMMANDS["close"]([]), 0)
+        self.assertEqual(calls, ["record", ("tab.close", {"tab_id": "w1:t2"})])
+
+    @patch.dict(os.environ, {"HERDR_TAB_ID": "w1:t2"}, clear=True)
+    def test_failed_record_leaves_tab_open(self):
+        with patch.object(cli, "cmd_record", return_value=1), patch.object(cli, "HerdrApi") as api:
+            self.assertEqual(cli.COMMANDS["close"]([]), 1)
+            api.assert_not_called()
+
+    @patch.dict(os.environ, {}, clear=True)
+    def test_missing_context_leaves_tabs_open(self):
+        with patch.object(cli, "HerdrApi") as api:
+            self.assertEqual(cli.COMMANDS["close"]([]), 1)
+            api.assert_not_called()
+
+    def test_failed_target_export_preserves_tab_and_previous_snapshot(self):
+        for export in (cli.HerdrApiError("export failed"), {}, {"layout": {"root": None}},
+                       {"layout": {"root": {"type": "split"}}}):
+            with self.subTest(export=export), tempfile.TemporaryDirectory() as state:
+                previous = {"version": 2, "closed": [], "index": {
+                    "w1:t2": {"tab_id": "w1:t2", "panes": [], "refreshed_ms": 100}}}
+                store.save_state(state, previous)
+                api = FakeApi({
+                    "tab.list": {"tabs": [{"tab_id": "w1:t2", "workspace_id": "w1"}]},
+                    "workspace.list": {"workspaces": []},
+                    "pane.list": {"panes": []},
+                    "agent.list": {"agents": []},
+                    "layout.export": export,
+                })
+                with patch.dict(os.environ, {"HERDR_TAB_ID": "w1:t2", "HERDR_PLUGIN_STATE_DIR": state}, clear=True), \
+                     patch.object(cli, "HerdrApi") as client, \
+                     patch.object(cli.config_mod, "load_config", return_value={"max_entries": 20, "undo_panes": False, "restore_process": True}), \
+                     patch.object(cli.record_mod, "current_time_ms", return_value=100):
+                    client.return_value.__enter__.return_value = api
+                    self.assertEqual(cli.cmd_close([]), 1)
+                self.assertNotIn("tab.close", [method for method, _ in api.calls])
+                self.assertEqual(store.load_state(state), previous)
